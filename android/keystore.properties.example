# Copy to keystore.properties (gitignored) to sign debug and release APKs.
# Published releases use the gladimdim-main key (alias "key", certificate
# SHA-256 8B:E4:25:A4…2D:36) so every APK updates the one before it.
# Without this file, debug builds use the SDK's debug key and release builds
# are unsigned. Never commit the real file or the keystore.
storeFile=/path/to/gladimdim-main.jks
storePassword=
keyAlias=key
keyPassword=
